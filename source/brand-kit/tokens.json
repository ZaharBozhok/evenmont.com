{
  "meta": {
    "brand": "Evenmont",
    "legal_owner": "JITO LTD (Evenmont is a registered business name)",
    "moods": {
      "client": ":root (default)",
      "partner": "[data-mood='partner']",
      "partner-dark": "[data-mood='partner-dark']"
    }
  },
  "color": {
    "client_palette_A": {
      "evergreen": "#0F3D34",
      "pine": "#1F5C4D",
      "sage": "#DCE7DF",
      "sand": "#F6F2EA",
      "ink": "#14201C",
      "stone": "#5F6661",
      "amber": "#F2A93B",
      "brick": "#A8322B"
    },
    "partner_palette_P": {
      "night": "#0C2621",
      "evergreen": "#0F3D34",
      "cobalt": "#2E5BFF",
      "sky": "#9DB9FF",
      "mist": "#E4E7EC",
      "paper": "#F7F7F4",
      "slate": "#5E6671"
    },
    "rules": [
      "Client pages: Amber is the only accent (CTA fill + sum line + logo accent), ~5% of area. Button text is Ink, never white.",
      "Partner pages: Cobalt is the only accent. Button text white. Links Cobalt on Paper, Sky on Night, Ink on Mist.",
      "Never Amber and Cobalt on the same page.",
      "Never use Odoo purple #714B67 or teal #017E84 as brand colors."
    ]
  },
  "typography": {
    "display": {
      "family": "Fraunces",
      "weight": 600,
      "file": "fonts/fraunces-600-latin.woff2",
      "use": "H1, H2, hero, big numbers. Static instance: opsz 36, SOFT 50, WONK 0 (calm shapes)."
    },
    "sans": {
      "family": "Manrope",
      "weights": "400-700 (variable)",
      "file": "fonts/manrope-var-latin.woff2",
      "use": "H3, body, UI, tables. Tables/prices: font-variant-numeric: tabular-nums (feature kept in subset)."
    },
    "mono": {
      "family": "IBM Plex Mono (optional, not bundled)",
      "use": "tiny technical labels only"
    },
    "scale_px": {
      "display": "40->64",
      "h1": "36->56",
      "h2": "28->40",
      "h3": "20->22",
      "lead": "18->21",
      "body": "17->18",
      "small": 15,
      "xs": 13
    },
    "line_height": {
      "tight": 1.08,
      "heading": 1.15,
      "snug": 1.35,
      "body": 1.6
    },
    "measure": "68ch"
  },
  "space_px": [
    4,
    8,
    12,
    16,
    24,
    32,
    48,
    64,
    96,
    128
  ],
  "radius_px": {
    "sm": 8,
    "button": 10,
    "card": 16,
    "pill": 999
  },
  "motion": {
    "ease_out": "cubic-bezier(0.2,0.8,0.2,1)",
    "ease_settle": "cubic-bezier(0.34,1.3,0.64,1)",
    "durations_ms": {
      "1": 150,
      "2": 250,
      "3": 400,
      "4": 600,
      "draw": 900
    },
    "stagger_ms": 80
  },
  "layout": {
    "container_px": 1200,
    "gutter": "clamp(20px,4vw,40px)",
    "section_y": "clamp(64px,8vw,128px)",
    "breakpoints_px": [
      360,
      480,
      768,
      1024,
      1280
    ],
    "tap_target_px": 44,
    "button_height_px": 48
  }
}