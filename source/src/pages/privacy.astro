---
/**
 * /privacy — DRAFT written for the pre-release preview, based on how this site actually
 * works (forms, no cookies, analytics off). It must be reviewed and approved by counsel
 * before launch; the draft notice stays until then.
 */
import LegalPage from '../components/LegalPage.astro';
import { settings } from '../lib/site';

const l = settings.legal;
const email = settings.contact.email;
---

<LegalPage
  title="Privacy policy"
  metaTitle="Privacy policy | Evenmont"
  description="How Evenmont collects, uses and protects personal data on evenmont.com and in our work with clients and partners."
  lead="Last updated: September 2026"
  draft="Draft for legal review — not yet approved."
>
  <section>
    <h2>Who we are</h2>
    <p>
      Evenmont is a registered business name of {l.legalName}, a company registered in {l.country} (reg. no. {l.regNo}),
      registered office {l.registeredOffice}. We are the controller of the personal data described in this policy. Contact us
      about privacy at <a href={`mailto:${email}`}>{email}</a>.
    </p>
  </section>
  <section>
    <h2>What personal data we collect</h2>
    <ul>
      <li>What you send us through our forms: your name, work email, company, team size, the tools you use, and your message.</li>
      <li>What you share when you book a call: your name, email and the time you choose.</li>
      <li>What you send us by email or phone.</li>
      <li>For partners: your firm’s name, your role and the details of clients you introduce, with their consent.</li>
    </ul>
    <p>We don’t use advertising trackers, and this site doesn’t set cookies.</p>
  </section>
  <section>
    <h2>How we use it</h2>
    <ul>
      <li>To reply to you, arrange calls and prepare proposals.</li>
      <li>To deliver and support the services you buy from us.</li>
      <li>To run our partner program, including referral fee payouts.</li>
      <li>To meet our legal and accounting obligations.</li>
    </ul>
  </section>
  <section>
    <h2>Legal basis</h2>
    <p>
      We process your data to take steps at your request before entering into a contract, to perform a contract with you, to
      comply with legal obligations, and for our legitimate interest in running and improving our business. Where we rely on
      consent, you can withdraw it at any time.
    </p>
  </section>
  <section>
    <h2>Who we share it with</h2>
    <p>
      We share data only with service providers who help us run our business — website hosting, form handling, email and our
      own Odoo instance — under data processing agreements. We never sell personal data.
    </p>
  </section>
  <section>
    <h2>International transfers</h2>
    <p>
      We are based in the European Union and work with clients in the United States. When data is transferred outside the EU, we
      use safeguards such as the European Commission’s standard contractual clauses.
    </p>
  </section>
  <section>
    <h2>How long we keep it</h2>
    <p>
      Enquiries that don’t lead to a project: up to 24 months. Client and partner records: for the length of the relationship
      and as long as tax and accounting law requires after it ends.
    </p>
  </section>
  <section>
    <h2>Your rights</h2>
    <p>
      You can ask for access to your data, a copy of it, correction, deletion or restriction, and you can object to how we use
      it. Email <a href={`mailto:${email}`}>{email}</a>. You can also complain to the Office of the Commissioner for Personal Data
      Protection in Cyprus, or to the authority where you live.
    </p>
  </section>
  <section>
    <h2>Cookies and analytics</h2>
    <p>
      This site does not use cookies. If we add analytics, we will use a cookieless tool that doesn’t identify individual visitors,
      and we will update this policy first.
    </p>
  </section>
  <section>
    <h2>Changes to this policy</h2>
    <p>We will post any changes on this page and update the date at the top.</p>
  </section>
</LegalPage>
