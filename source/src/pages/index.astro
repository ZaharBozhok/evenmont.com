---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/sections/HomeHero.astro';
import TrustStrip from '../components/sections/TrustStrip.astro';
import ScenarioSwitcher from '../components/sections/ScenarioSwitcher.astro';
import Section from '../components/Section.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import CompareSlider from '../components/illustrations/CompareSlider.astro';
import CtaBand from '../components/CtaBand.astro';
import CasesSection from '../components/sections/CasesSection.astro';
import Calculator from '../components/sections/Calculator.astro';
import Timeline from '../components/Timeline.astro';
import Icon from '../components/Icon.astro';
import LinkArrow from '../components/LinkArrow.astro';
import Pricing from '../components/sections/Pricing.astro';
import CheckUs from '../components/sections/CheckUs.astro';
import Faq from '../components/sections/Faq.astro';
import FinalCta from '../components/sections/FinalCta.astro';
import { Picture } from 'astro:assets';
import workshop from '../assets/placeholders/blueprint-workshop.jpg';
import { getTerms } from '../lib/terms';
import type { IconName } from '../icons/lucide';

// Home: offer → problems → what changes → the cost of the problem → cases → process → prices
// → proof → FAQ → request form, with a CTA band roughly every second screen.
const terms = await getTerms();
const stepIcons: Record<string, IconName> = { 'fit-call': 'video', blueprint: 'map', build: 'layers', 'go-live': 'calendar-check', keep: 'life-buoy' };
const steps = terms.process.steps.map((s) => ({ name: s.name, get: terms.fmt(s.get), time: terms.fmt(s.time), price: terms.fmt(s.price), icon: stepIcons[s.id] }));

const whatChanges = [
  { today: 'Twelve tools, copy-paste between them', after: 'One system, every number entered once' },
  { today: 'Profit per project or product is a guess', after: 'Live margin by project, product and customer' },
  { today: 'Stock counts nobody trusts', after: 'Real-time inventory with barcode scanning' },
  { today: 'Production planned on a whiteboard', after: 'Work orders, bills of materials and real unit costs' },
  { today: 'Contractors paid from email', after: 'Rates, timesheets, invoices and payouts in one flow' },
  { today: 'Close drags on', after: 'Close without spreadsheet marathons, together with your accountant' },
];
---

<BaseLayout
  title="Evenmont — Finance-first Odoo implementation"
  description="We implement Odoo for growing US service firms, distributors and manufacturers. Fixed-price phases, your accountant in the loop, a founder on every project."
>
  <HomeHero />
  <TrustStrip />
  <ScenarioSwitcher />

  <Section id="what-changes" title="What changes" intro="Drag the handle: twelve tools on the left, one system on the right." tone="alt">
    <div class="changes">
      <CompareSlider />
      <BeforeAfter rows={whatChanges} caption="What changes: today compared with Evenmont" />
    </div>
    <CtaBand title="Want one system instead of twelve tools?" label="Book a free call" />
  </Section>

  <Calculator />
  <CasesSection />

  <Section id="process" title="How we work" intro="Five steps, a fixed price for each, and a founder on every one." tone="alt">
    <figure class="process__photo" data-reveal>
      <Picture
        src={workshop}
        alt="A small team planning a process on a large sheet of paper spread across a table"
        widths={[640, 960, 1280, 1600]}
        sizes="(min-width: 1280px) 1200px, calc(100vw - 2 * clamp(20px, 4vw, 40px))"
        formats={['avif', 'webp']}
        loading="lazy"
        decoding="async"
        data-placeholder="true"
      />
      <figcaption class="process__card">
        <span class="process__kicker">Where every project starts</span>
        <strong>The Blueprint</strong>
        <span>Your process on one page, today’s numbers measured, and a fixed price — before anything is built.</span>
      </figcaption>
    </figure>
    <Timeline steps={steps} />
    <p class="process__note">{terms.fmt(terms.process.note)}</p>
    <div class="accountant" data-reveal>
      <span class="accountant__icon">
        <Icon name="calculator" size={24} />
      </span>
      <div>
        <h3>Built with your accountant, not around them.</h3>
        <p>The books stay with the person who knows them. We build the system around their rules.</p>
      </div>
      <LinkArrow href="/partners" class="accountant__link">Are you an accountant? See the partner program</LinkArrow>
    </div>
    <CtaBand title="Want your process on one page, with a fixed price?" label="Get a quick Blueprint" />
  </Section>

  <Pricing />
  <CheckUs />
  <CtaBand standalone title="Questions? Talk to a founder, not a sales team." label="Talk to a founder" />
  <Faq id="home" />
  <FinalCta />
</BaseLayout>

<style>
  .changes {
    display: grid;
    gap: var(--space-6);
  }
  .process__photo {
    position: relative;
    margin: 0 0 var(--space-7);
  }
  .process__photo :global(picture) {
    display: block;
    overflow: hidden;
    border-radius: 20px;
    aspect-ratio: 4 / 3;
  }
  .process__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 50%;
  }
  /* Phones: the card overlaps the bottom of the photo; wider: it floats on the photo. */
  .process__card {
    position: relative;
    display: grid;
    gap: var(--space-1);
    margin: calc(-1 * var(--space-7)) var(--space-3) 0;
    padding: var(--space-4) var(--space-5);
    border-radius: 16px;
    background-color: var(--surface);
    box-shadow: 0 12px 32px -12px rgba(20, 32, 28, 0.4);
    font-size: var(--fs-small);
    line-height: 1.45;
  }
  .process__card strong {
    font-size: var(--fs-h3);
    color: var(--heading);
  }
  .process__kicker {
    color: var(--link);
    font-size: var(--fs-xs);
    font-weight: 800;
  }
  @media (min-width: 768px) {
    .process__photo :global(picture) {
      aspect-ratio: 21 / 8;
    }
    .process__card {
      position: absolute;
      left: var(--space-6);
      bottom: var(--space-6);
      max-width: 380px;
      margin: 0;
    }
  }
  .process__note {
    max-width: none;
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid var(--border);
    font-weight: 700;
  }
  /* "Built with your accountant" folded into one line under the process. */
  .accountant {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-3) var(--space-4);
    align-items: start;
    margin-top: var(--space-6);
    padding: var(--space-5);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    background-color: var(--surface);
  }
  .accountant__icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background-color: var(--heading);
    color: var(--em-sand);
  }
  .accountant p {
    margin-top: var(--space-1);
    color: var(--text-muted);
  }
  .accountant :global(.accountant__link) {
    grid-column: 2;
    padding-block: 0;
  }
  @media (min-width: 1024px) {
    .accountant {
      grid-template-columns: auto minmax(0, 1fr) auto;
      align-items: center;
      gap: var(--space-5);
      padding: var(--space-5) var(--space-6);
    }
    .accountant :global(.accountant__link) {
      grid-column: 3;
    }
  }
</style>
