---
/**
 * Inline Lucide icon (outline, 1.5px stroke, currentColor). Decorative by default.
 * `draw` adds pathLength="1" + .draw so the strokes can draw in (see base.css).
 */
import { icons, type IconName } from '../icons/lucide';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  label?: string;
  draw?: boolean;
  strokeWidth?: number;
}
const { name, size = 24, class: className, label, draw = false, strokeWidth = 1.5 } = Astro.props;
let body: string = icons[name];
if (draw) body = body.replace(/<(path|line|polyline|polygon)\b/g, '<$1 pathLength="1" class="draw"');
if (label) body = `<title>${label}</title>` + body;
---

<svg
  class:list={['icon', className]}
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  focusable="false"
  set:html={body}
/>
