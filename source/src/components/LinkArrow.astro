---
/** Text link with arrow — "All case studies →". Arrow nudges 3px on hover. */
import Icon from './Icon.astro';

interface Props {
  href: string;
  class?: string;
  download?: boolean;
  external?: boolean;
}
const { href, class: className, download, external } = Astro.props;
---

<a
  href={href}
  class:list={['link-arrow', className]}
  download={download ? '' : undefined}
  rel={external ? 'noopener' : undefined}
>
  <span class="link-arrow__label"><slot /></span>
  <Icon name="arrow-right" size={18} class="arrow-nudge" />
</a>
