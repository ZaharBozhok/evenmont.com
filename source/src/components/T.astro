---
/**
 * Renders a copy string: escapes HTML and marks {{PLACEHOLDER}} tokens with .ph
 * so they stay visible and easy to find. Pass `fmt` output for ⚑ terms.
 */
import { phHtml } from '../lib/text';

interface Props {
  v: string;
}
const { v } = Astro.props;
---

<Fragment set:html={phHtml(v)} />
