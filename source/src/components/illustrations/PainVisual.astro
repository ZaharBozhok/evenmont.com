---
/**
 * "Problem screens" for the Sound familiar? cards — the brand's main visual genre (a
 * screen in a neutral frame + one accent annotation), showing the pain instead of
 * describing it. One per pain: services / distribution / manufacturing × 3.
 * DEMO data. Decorative: the pain itself is the card's text.
 */
interface Props {
  scenario: 'services' | 'distribution' | 'manufacturing';
  index: number;
}
const { scenario, index } = Astro.props;
const id = `${scenario}-${index}`;

const titles: Record<string, string> = {
  'services-0': 'Hwy 36 assessment · Closed',
  'services-1': 'Inbox · 214 unread',
  'services-2': 'Close_Sept_v7_FINAL (2).xlsx',
  'distribution-0': 'SKU 1042 · Cast iron pan',
  'distribution-1': 'Orders · Today',
  'distribution-2': 'Month-end · Inventory value',
  'manufacturing-1': 'Cost sheet · last updated 2021',
  'manufacturing-2': 'Lot 2291 · Where did it go?',
};
const pills: Record<string, string> = {
  'services-0': 'Found 34 days after close',
  'services-1': '3 invoices, 0 approved',
  'services-2': 'Day 11 of the close',
  'distribution-0': 'Counted by hand on Friday',
  'distribution-1': 'Stock synced once a day',
  'distribution-2': 'Nobody can explain the gap',
  'manufacturing-0': 'Erased every Monday',
  'manufacturing-1': 'Prices are set from this',
  'manufacturing-2': '5 days of digging',
};
const pill = pills[id];
const pillW = Math.round(pill.length * 5.7 + 30);
const title = titles[id];

const mail = [
  { ini: 'JA', who: 'J. Alvarez', what: 'Invoice — March (revised)' },
  { ini: 'TB', who: 'T. Brooks', what: 'Re: Re: invoice attached?' },
  { ini: 'MP', who: 'M. Patel', what: 'Fwd: hours + invoice' },
];
const sheet = [
  ['Revenue', '412,800', '398,100'],
  ['COGS', '251,300', '#REF!'],
  ['Freight', '18,420', '18,420'],
  ['Margin', '#REF!', '38.1%'],
  ['Check', '≠ 0', ''],
];
const orders = [
  { ch: 'Shopify', what: '#10482 · Kettle × 2', ok: true },
  { ch: 'Amazon', what: '#10483 · Kettle × 1', ok: false },
  { ch: 'Amazon', what: '#10484 · Kettle × 3', ok: false },
];
const cost = [
  ['Lumber', '$180'],
  ['Hardware', '$24'],
  ['Labor', '???'],
  ['Overhead', '???'],
];
---

<svg class="pv" viewBox="0 0 320 184" aria-hidden="true" focusable="false">
  <rect class="pv__bg" width="320" height="184" rx="14" />
  {
    scenario === 'manufacturing' && index === 0 ? (
      <g>
        <rect class="pv__board" x="18" y="14" width="284" height="148" rx="6" />
        <path class="pv__tray" d="M40 168h240" />
        {['Mon', 'Tue', 'Wed', 'Thu', 'Fri'].map((d, i) => (
          <text class="pv__hand" x={96 + i * 44} y="34" text-anchor="middle">
            {d}
          </text>
        ))}
        {['Saw', 'Build', 'Finish'].map((r, i) => (
          <text class="pv__hand" x="30" y={66 + i * 36}>
            {r}
          </text>
        ))}
        <path class="pv__marker" d="M72 42c60-1.5 150 1.5 218-.5M73 80c70 1.5 140-1 216 .5M72 116c64-1 152 1.5 217-.5M74 40c-1 40 1.5 80-.5 116" />
        <g transform="rotate(-4 108 60)">
          <rect class="pv__note" x="84" y="47" width="50" height="26" rx="2" />
          <text class="pv__notet" x="90" y="64">Oak ×6?</text>
        </g>
        <g transform="rotate(3 190 96)">
          <rect class="pv__note pv__note--sage" x="164" y="84" width="52" height="26" rx="2" />
          <text class="pv__notet" x="170" y="101">Bench</text>
        </g>
        <g transform="rotate(-2 250 130)">
          <rect class="pv__note" x="226" y="118" width="52" height="26" rx="2" />
          <text class="pv__notet" x="232" y="135">Chairs ??</text>
        </g>
        <path class="pv__marker pv__marker--x" d="M166 50l38 22M204 50l-38 22" />
        <path class="pv__marker" d="M136 64c20 4 26 14 28 22m-7-5 7 6 3-8" />
      </g>
    ) : (
      <g>
        <rect class="pv__win" x="18" y="16" width="284" height="146" rx="10" />
        <path class="pv__bar" d="M18.5 26.5a10 10 0 0 1 10-10h263a10 10 0 0 1 10 10v11h-283z" />
        <circle class="pv__dot" cx="30" cy="27" r="2.6" />
        <circle class="pv__dot" cx="39" cy="27" r="2.6" />
        <circle class="pv__dot" cx="48" cy="27" r="2.6" />
        <text class="pv__title" x="60" y="30.5">{title}</text>
      </g>
    )
  }

  {
    id === 'services-0' && (
      <g>
        <text class="pv__m" x="32" y="62">Budget</text>
        <rect class="pv__sage" x="86" y="53" width="148" height="11" rx="5.5" />
        <text class="pv__v" x="290" y="62" text-anchor="end">$48,000</text>
        <text class="pv__m" x="32" y="87">Actual</text>
        <rect class="pv__ever" x="86" y="78" width="148" height="11" rx="5.5" />
        <path class="pv__neg" d="M226 78h16.5a5.5 5.5 0 0 1 0 11H226z" />
        <path class="pv__dash" d="M234 46v50" />
        <text class="pv__v pv__negt" x="290" y="87" text-anchor="end">$54,240</text>
        <path class="pv__rule" d="M32 104h258" />
        <text class="pv__m" x="32" y="124">Project margin</text>
        <text class="pv__big pv__negt" x="32" y="150">−13%</text>
      </g>
    )
  }
  {
    id === 'services-1' && (
      <g>
        {mail.map((m, i) => (
          <g>
            <circle class="pv__sage" cx="41" cy={60 + i * 32} r="10" />
            <text class="pv__ini" x="41" y={63.5 + i * 32} text-anchor="middle">
              {m.ini}
            </text>
            <text class="pv__v" x="59" y={57 + i * 32}>
              {m.who}
            </text>
            <text class="pv__m pv__s" x="59" y={70 + i * 32}>
              {m.what}
            </text>
            <path class="pv__clip" d={`M244 ${58 + i * 32}l-6.5 6.5a3 3 0 0 1-4.3-4.3l7-7a2 2 0 0 1 2.8 2.8l-6.4 6.4`} />
            <rect class="pv__chip" x="252" y={52 + i * 32} width="36" height="16" rx="4" />
            <text class="pv__chipt" x="270" y={63 + i * 32} text-anchor="middle">
              PDF
            </text>
            {i < 2 && <path class="pv__rule" d={`M32 ${76 + i * 32}h258`} />}
          </g>
        ))}
      </g>
    )
  }
  {
    id === 'services-2' && (
      <g>
        <rect class="pv__head" x="18.5" y="38" width="283" height="15" />
        {['', 'A', 'B', 'C'].map((c, i) => (
          <text class="pv__m pv__s" x={[28, 84, 165, 235][i]} y="49" text-anchor="middle">
            {c}
          </text>
        ))}
        {sheet.map((r, i) => (
          <g>
            {i === 3 && <rect class="pv__hi" x="200" y={53 + i * 17} width="70" height="17" />}
            <text class="pv__m pv__s" x="28" y={65 + i * 17} text-anchor="middle">
              {i + 1}
            </text>
            <text class="pv__v pv__s" x="46" y={65 + i * 17}>
              {r[0]}
            </text>
            <text class:list={['pv__v pv__s', r[1].startsWith('#') || r[1].startsWith('≠') ? 'pv__negt' : '']} x="192" y={65 + i * 17} text-anchor="end">
              {r[1]}
            </text>
            <text class:list={['pv__v pv__s', r[2].startsWith('#') ? 'pv__negt' : '']} x="262" y={65 + i * 17} text-anchor="end">
              {r[2]}
            </text>
          </g>
        ))}
        <path class="pv__grid" d="M38 38v101M130 38v101M200 38v101M270 38v101M18.5 53h283M18.5 70h283M18.5 87h283M18.5 104h283M18.5 121h283M18.5 138h283" />
        <rect class="pv__tab pv__tab--on" x="40" y="142" width="34" height="14" rx="2" />
        <text class="pv__tabt" x="57" y="152" text-anchor="middle">Sep</text>
        <rect class="pv__tab" x="78" y="142" width="48" height="14" rx="2" />
        <text class="pv__tabt" x="102" y="152" text-anchor="middle">Sep (2)</text>
        <rect class="pv__tab" x="130" y="142" width="64" height="14" rx="2" />
        <text class="pv__tabt" x="162" y="152" text-anchor="middle">Recon OLD</text>
      </g>
    )
  }
  {
    id === 'distribution-0' && (
      <g>
        <text class="pv__m" x="40" y="64">In the system</text>
        <text class="pv__huge" x="40" y="118">40</text>
        <text class="pv__neq" x="152" y="108" text-anchor="middle">≠</text>
        <text class="pv__m" x="186" y="64">On the shelf</text>
        <text class="pv__huge pv__negt" x="186" y="118">12</text>
        <path class="pv__rule" d="M32 132h258" />
        <text class="pv__m pv__s" x="40" y="150">3 orders already promised</text>
      </g>
    )
  }
  {
    id === 'distribution-1' && (
      <g>
        {orders.map((o, i) => (
          <g>
            <rect class="pv__sage" x="30" y={50 + i * 32} width="54" height="18" rx="9" />
            <text class="pv__chipt pv__chipt--ink" x="57" y={62.5 + i * 32} text-anchor="middle">
              {o.ch}
            </text>
            <text class="pv__v" x="94" y={63 + i * 32}>
              {o.what}
            </text>
            {o.ok ? (
              <text class="pv__v pv__post" x="290" y={63 + i * 32} text-anchor="end">
                ✓ Ready
              </text>
            ) : (
              <g>
                <rect class="pv__bad" x="216" y={50 + i * 32} width="74" height="18" rx="9" />
                <text class="pv__chipt pv__negt" x="253" y={62.5 + i * 32} text-anchor="middle">
                  Out of stock
                </text>
              </g>
            )}
            {i < 2 && <path class="pv__rule" d={`M30 ${75 + i * 32}h260`} />}
          </g>
        ))}
      </g>
    )
  }
  {
    id === 'distribution-2' && (
      <g>
        <text class="pv__m" x="32" y="60">Warehouse count</text>
        <rect class="pv__ever" x="32" y="67" width="176" height="12" rx="6" />
        <text class="pv__v" x="290" y="77" text-anchor="end">$96,450</text>
        <text class="pv__m" x="32" y="100">Books</text>
        <rect class="pv__pine" x="32" y="107" width="190" height="12" rx="6" />
        <text class="pv__v" x="290" y="117" text-anchor="end">$104,120</text>
        <path class="pv__dash" d="M208 62v62M222 102v22" />
        <path class="pv__brace" d="M208 130h14" />
        <text class="pv__m" x="32" y="150">Gap</text>
        <text class="pv__v pv__negt" x="62" y="150">−$7,670</text>
      </g>
    )
  }
  {
    id === 'manufacturing-1' && (
      <g>
        {cost.map((c, i) => (
          <g>
            <text class="pv__m" x="32" y={60 + i * 21}>
              {c[0]}
            </text>
            <text class:list={['pv__v', c[1] === '???' && 'pv__negt']} x="290" y={60 + i * 21} text-anchor="end">
              {c[1]}
            </text>
            <path class="pv__rule" d={`M32 ${67 + i * 21}h258`} />
          </g>
        ))}
        <text class="pv__v" x="32" y="150">Unit cost ≈ $420?</text>
      </g>
    )
  }
  {
    id === 'manufacturing-2' && (
      <g>
        <rect class="pv__box" x="30" y="78" width="66" height="28" rx="7" />
        <text class="pv__v pv__s" x="63" y="95.5" text-anchor="middle">Lot 2291</text>
        <path class="pv__link" d="M96 92c16 0 18-36 36-36M96 92h36M96 92c16 0 18 36 36 36" />
        {['WO-188', 'WO-190', '?'].map((t, i) => (
          <g>
            <rect class:list={['pv__box', i === 2 && 'pv__box--bad']} x="132" y={45 + i * 36} width="62" height="22" rx="6" />
            <text class:list={['pv__v pv__s', i === 2 && 'pv__negt']} x="163" y={60 + i * 36} text-anchor="middle">
              {t}
            </text>
          </g>
        ))}
        <path class="pv__link pv__link--dash" d="M194 56c14 0 16 36 30 36M194 92h30M194 128c14 0 16-36 30-36" />
        <rect class="pv__box pv__box--bad" x="224" y="78" width="66" height="28" rx="7" />
        <text class="pv__v pv__s pv__negt" x="257" y="95.5" text-anchor="middle">Customers?</text>
      </g>
    )
  }

  <rect class="pv__pill" x={302 - pillW} y="150" width={pillW} height="26" rx="13" />
  <text class="pv__pillt" x={302 - pillW / 2} y="167" text-anchor="middle">{pill}</text>
</svg>

<style is:global>
  /* Pain card: problem screen on top, the pain in one line below (shared with the scenario pages). */
  .pain {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-3);
  }
  .pain > * + * {
    margin-top: 0;
  }
  .pain p {
    padding: 0 var(--space-3) var(--space-3);
    font-size: var(--fs-h3);
    font-weight: 700;
    line-height: var(--lh-snug);
    color: var(--heading);
  }
  .pv {
    display: block;
    width: 100%;
    height: auto;
    font-family: var(--font-sans);
    font-variant-numeric: tabular-nums;
  }
  .pv text {
    font-size: 10px;
    font-weight: 600;
  }
  .pv__bg { fill: color-mix(in srgb, var(--surface-alt) 70%, var(--bg)); }
  .pv__win { fill: var(--surface); stroke: var(--border); }
  .pv__bar,
  .pv__head { fill: color-mix(in srgb, var(--surface-alt) 60%, var(--surface)); }
  .pv__dot { fill: var(--text-muted); opacity: 0.35; }
  .pv .pv__title { fill: var(--text-muted); font-size: 9.5px; font-weight: 700; }
  .pv__m { fill: var(--text-muted); }
  .pv__v { fill: var(--text); }
  .pv .pv__v { font-weight: 700; }
  .pv .pv__s { font-size: 9px; }
  .pv .pv__big { font-size: 22px; font-weight: 800; }
  .pv .pv__huge { font-size: 44px; font-weight: 800; fill: var(--heading); }
  .pv .pv__neq { font-size: 26px; fill: var(--text-muted); }
  .pv__negt { fill: var(--error); }
  .pv .pv__huge.pv__negt { fill: var(--error); }
  .pv__post { fill: var(--link); }
  .pv__neg { fill: var(--error); }
  .pv__sage { fill: var(--surface-alt); }
  .pv__ever { fill: var(--heading); }
  .pv__pine { fill: color-mix(in srgb, var(--link) 55%, var(--surface)); }
  .pv__hi { fill: color-mix(in srgb, var(--rule) 30%, var(--surface)); }
  .pv__rule,
  .pv__grid { stroke: var(--border); fill: none; }
  .pv__dash { stroke: var(--text-muted); stroke-width: 1.2; stroke-dasharray: 3 3; fill: none; }
  .pv__brace { stroke: var(--error); stroke-width: 2; stroke-linecap: round; }
  .pv .pv__ini { fill: var(--heading); font-size: 8px; font-weight: 800; }
  .pv__clip { fill: none; stroke: var(--text-muted); stroke-width: 1.3; stroke-linecap: round; }
  .pv__chip { fill: none; stroke: var(--border); }
  .pv .pv__chipt { fill: var(--text-muted); font-size: 8.5px; font-weight: 800; }
  .pv .pv__chipt--ink { fill: var(--heading); }
  .pv .pv__chipt.pv__negt { fill: var(--error); }
  .pv__bad { fill: color-mix(in srgb, var(--error) 8%, var(--surface)); stroke: color-mix(in srgb, var(--error) 45%, transparent); }
  .pv__tab { fill: color-mix(in srgb, var(--surface-alt) 60%, var(--surface)); stroke: var(--border); }
  .pv__tab--on { fill: var(--surface); }
  .pv .pv__tabt { fill: var(--text-muted); font-size: 8px; font-weight: 700; }
  .pv__box { fill: var(--surface); stroke: var(--heading); stroke-width: 1.3; }
  .pv__box--bad { stroke: var(--error); stroke-dasharray: 3 2.5; }
  .pv__link { fill: none; stroke: var(--heading); stroke-width: 1.3; }
  .pv__link--dash { stroke: var(--error); stroke-dasharray: 3 3; }
  /* whiteboard */
  .pv__board { fill: var(--surface); stroke: color-mix(in srgb, var(--text-muted) 55%, transparent); stroke-width: 2.5; }
  .pv__tray { stroke: color-mix(in srgb, var(--text-muted) 55%, transparent); stroke-width: 4; stroke-linecap: round; }
  .pv .pv__hand { fill: var(--text-muted); font-size: 9.5px; font-weight: 700; }
  .pv__marker { fill: none; stroke: var(--heading); stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round; opacity: 0.55; }
  .pv__marker--x { stroke: var(--error); opacity: 0.7; }
  .pv__note { fill: color-mix(in srgb, var(--rule) 45%, var(--surface)); }
  .pv__note--sage { fill: var(--surface-alt); }
  .pv .pv__notet { fill: var(--text); font-size: 9px; font-weight: 700; }
  /* annotation */
  .pv__pill { fill: var(--rule); }
  .pv .pv__pillt { fill: var(--on-accent); font-size: 10px; font-weight: 800; }
</style>
