---
/**
 * 24px line icons for the scenario tabs (#5): services = clock + invoice,
 * distribution = box + arrows, manufacturing = gear + workbench.
 * Strokes redraw when their tab is selected.
 */
interface Props {
  scenario: 'services' | 'distribution' | 'manufacturing';
  class?: string;
}
const { scenario, class: className } = Astro.props;
const paths: Record<string, string[]> = {
  services: [
    'M13 3H6.5A1.5 1.5 0 0 0 5 4.5v15A1.5 1.5 0 0 0 6.5 21H11',
    'M13 3l5 5v2.5',
    'M13 3v5h5',
    'M8 9h2.5',
    'M8 13h3.5',
    'M22 17a5 5 0 1 1-10 0a5 5 0 1 1 10 0',
    'M17 14.5V17l1.8 1.2',
  ],
  distribution: [
    'M2 9.5 8 6l6 3.5v7L8 20l-6-3.5z',
    'M2 9.5 8 13l6-3.5',
    'M8 13v7',
    'M16 7.5h6',
    'M19.5 5 22 7.5 19.5 10',
    'M22 16.5h-6',
    'M18.5 14 16 16.5l2.5 2.5',
  ],
  manufacturing: [
    'M15.5 7.5a3.5 3.5 0 1 1-7 0a3.5 3.5 0 1 1 7 0',
    'M12 1.5v2',
    'M12 11.5v2',
    'M6 7.5h2',
    'M16 7.5h2',
    'M7.8 3.3l1.4 1.4',
    'M14.8 10.3l1.4 1.4',
    'M7.8 11.7l1.4-1.4',
    'M14.8 4.7l1.4-1.4',
    'M2 16h20',
    'M5 16v6',
    'M19 16v6',
    'M5 19.5h14',
  ],
};
---

<svg
  class:list={['scenario-icon', className]}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width="24"
  height="24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {paths[scenario].map((d, i) => <path class="redraw" pathLength="1" style={`--i:${i}`} d={d} />)}
</svg>
