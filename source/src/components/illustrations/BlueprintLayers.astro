---
/**
 * #15 Blueprint grid + layers — a faint Sky grid draws in; the "Your brand" card slides
 * over the "Evenmont" card (translateX 12px → 0): we stay invisible behind your brand.
 */
const cols = Array.from({ length: 11 }, (_, i) => 20 + i * 40);
const rows = Array.from({ length: 8 }, (_, i) => 20 + i * 40);
---

<figure class="layers" data-animate role="img" aria-label="Illustration: your brand in front, the Evenmont team working behind it.">
  <svg class="layers__grid" viewBox="0 0 440 320" aria-hidden="true" focusable="false" preserveAspectRatio="xMidYMid slice">
    {cols.map((x, i) => <path class="draw" pathLength="1" style={`--i:${i};--stagger:30ms`} d={`M${x} 0V320`} />)}
    {rows.map((y, i) => <path class="draw" pathLength="1" style={`--i:${i + 4};--stagger:30ms`} d={`M0 ${y}H440`} />)}
  </svg>
  <div class="layers__stack" aria-hidden="true">
    <div class="layers__card layers__card--back">
      <p class="layers__tag">Evenmont</p>
      <span class="layers__line" style="width:72%"></span>
      <span class="layers__line" style="width:54%"></span>
      <span class="layers__line" style="width:64%"></span>
      <span class="layers__code"><span></span><span></span><span></span></span>
    </div>
    <div class="layers__card layers__card--front">
      <p class="layers__tag layers__tag--brand"><span class="layers__logo"></span>Your brand</p>
      <span class="layers__line layers__line--strong" style="width:62%"></span>
      <span class="layers__line" style="width:84%"></span>
      <span class="layers__line" style="width:76%"></span>
      <span class="layers__line" style="width:48%"></span>
      <span class="layers__btn"></span>
    </div>
  </div>
</figure>

<style is:global>
  .layers {
    position: relative;
    margin: 0;
    aspect-ratio: 11 / 8;
    width: 100%;
  }
  .layers__grid {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .layers__grid path {
    fill: none;
    stroke: var(--rule);
    stroke-width: 1;
    opacity: 0.08;
  }
  .layers__stack {
    position: absolute;
    inset: 10% 8%;
  }
  .layers__card {
    position: absolute;
    display: grid;
    align-content: start;
    gap: 10px;
    width: 72%;
    padding: 18px;
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    background-color: var(--surface);
  }
  .layers__card--back {
    top: 0;
    right: 0;
    height: 70%;
    opacity: 0.9;
  }
  .layers__card--front {
    left: 0;
    bottom: 0;
    height: 74%;
    border-color: color-mix(in srgb, var(--rule) 45%, transparent);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.35);
  }
  .layers__tag {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 4px;
    color: var(--text-muted);
    font-size: var(--fs-xs);
    font-weight: 700;
  }
  .layers__tag--brand {
    color: var(--text);
  }
  .layers__logo {
    width: 18px;
    height: 18px;
    border-radius: 5px;
    border: 2px solid var(--rule);
  }
  .layers__line {
    display: block;
    height: 8px;
    border-radius: 4px;
    background-color: var(--text-muted);
    opacity: 0.35;
  }
  .layers__line--strong {
    height: 12px;
    opacity: 0.8;
    background-color: var(--text);
  }
  .layers__code {
    display: grid;
    gap: 6px;
    margin-top: 8px;
    padding: 10px;
    border-radius: 8px;
    background-color: var(--bg);
  }
  .layers__code span {
    display: block;
    height: 6px;
    border-radius: 3px;
    background-color: var(--rule);
    opacity: 0.35;
  }
  .layers__code span:nth-child(1) {
    width: 60%;
  }
  .layers__code span:nth-child(2) {
    width: 80%;
  }
  .layers__code span:nth-child(3) {
    width: 45%;
  }
  .layers__btn {
    display: block;
    width: 38%;
    height: 22px;
    margin-top: 6px;
    border-radius: 6px;
    background-color: var(--accent);
    border: 1px solid var(--accent-edge);
  }
  @media (prefers-reduced-motion: no-preference) {
    .js .layers:not(.is-in) .layers__card--front {
      opacity: 0;
      transform: translateX(12px);
    }
    .js .layers__card--front {
      transition:
        opacity var(--dur-3) var(--ease-out) 450ms,
        transform var(--dur-4) var(--ease-settle) 450ms;
    }
  }
</style>
