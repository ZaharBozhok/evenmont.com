---
/**
 * "Who we are" — a photo of the founders at work, the two founders and the quarterly
 * capacity ⚑ as four slots. The photo is a placeholder (see placeholders.json / DEMO-CONTENT.md).
 */
import { Picture } from 'astro:assets';
import Section from '../Section.astro';
import LinkArrow from '../LinkArrow.astro';
import Avatar from '../Avatar.astro';
import Icon from '../Icon.astro';
import T from '../T.astro';
import photo from '../../assets/placeholders/founders-at-work.jpg';
import { settings } from '../../lib/site';
import { getTerms } from '../../lib/terms';

interface Props {
  /** Show the "More about us" link (not on /about itself). */
  more?: boolean;
  tone?: 'default' | 'alt';
}
const { more = true, tone = 'default' } = Astro.props;
const terms = await getTerms();
const slots = Number(terms.vars.projectsPerQuarter) || 0;
---

<Section id="who-we-are" tone={tone}>
  <div class="founders">
    <figure class="founders__photo" data-reveal>
      <Picture
        src={photo}
        alt="Two colleagues working side by side at a laptop in a bright office"
        widths={[480, 720, 960]}
        sizes="(min-width: 1024px) 460px, calc(100vw - 2 * clamp(20px, 4vw, 40px))"
        formats={['avif', 'webp']}
        loading="lazy"
        decoding="async"
        data-placeholder="true"
      />
      <figcaption class="founders__badge">
        <Icon name="user-check" size={18} />
        A founder on every project
      </figcaption>
    </figure>

    <div class="founders__copy">
      <p class="eyebrow">Who we are</p>
      <h2>Two founders, both on your project.</h2>
      <p class="lead">We moved our own company to Odoo first. Europe-based, with daily overlap with US business hours.</p>

      <ul class="founders__people" role="list">
        {
          settings.founders.map((f, i) => (
            <li class="fperson">
              <Avatar name={f.name} size={56} tone={i === 0 ? 2 : 1} />
              <div>
                <h3 class="fperson__name">
                  <T v={f.name} />
                </h3>
                <p class="fperson__role">{f.role}</p>
                <p class="fperson__bio">
                  <T v={f.bio} />
                </p>
              </div>
            </li>
          ))
        }
      </ul>

      <div class="capacity-row">
        <span class="capacity-row__slots" aria-hidden="true">
          {Array.from({ length: slots }, () => <span />)}
        </span>
        <p><T v={terms.fmt('We take on {projectsPerQuarter} new projects per quarter.')} /></p>
      </div>
      {more && <LinkArrow href="/about">More about us</LinkArrow>}
    </div>
  </div>
</Section>

<style is:global>
  .founders {
    display: grid;
    gap: var(--space-7);
    align-items: start;
  }
  .founders__photo {
    position: relative;
    margin: 0;
    overflow: hidden;
    border-radius: 24px;
    aspect-ratio: 4 / 5;
    max-height: 640px;
  }
  .founders__photo picture {
    display: block;
    height: 100%;
  }
  .founders__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .founders__badge {
    position: absolute;
    left: var(--space-4);
    bottom: var(--space-4);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 10px 16px;
    border-radius: var(--radius-pill);
    background-color: var(--surface);
    color: var(--heading);
    font-weight: 800;
    font-size: var(--fs-small);
    box-shadow: 0 10px 24px -10px rgba(20, 32, 28, 0.45);
  }
  .founders__badge .icon {
    color: var(--link);
  }
  .founders__copy {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
  }
  .founders__copy > .eyebrow {
    margin-bottom: calc(-1 * var(--space-3));
    color: var(--text-muted);
  }
  .founders__people {
    display: grid;
    gap: var(--space-4);
    width: 100%;
  }
  .fperson {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-4);
    padding: var(--space-4);
    border-radius: 16px;
    background-color: var(--surface);
    border: 1px solid var(--border);
  }
  .fperson__name {
    font-size: 1.125rem;
  }
  .fperson__role {
    color: var(--link);
    font-size: var(--fs-small);
    font-weight: 700;
  }
  .fperson__bio {
    margin-top: var(--space-2);
    font-size: var(--fs-small);
    line-height: 1.55;
  }
  .capacity-row {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    font-weight: 700;
  }
  .capacity-row__slots {
    display: inline-flex;
    gap: 6px;
  }
  .capacity-row__slots span {
    width: 14px;
    height: 28px;
    border-radius: 4px;
    background-color: var(--rule);
  }
  @media (min-width: 1024px) {
    .founders {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--space-8);
    }
    .founders__photo {
      position: sticky;
      top: var(--space-6);
    }
  }
</style>
