---
/**
 * Pricing (id="pricing") — ⚑ package cards from terms.json, ledger grid background, and the
 * ⚑ guarantees ("Our promises, in writing.") as a short checklist under the packages.
 */
import Section from '../Section.astro';
import PackageCard from '../PackageCard.astro';
import Button from '../Button.astro';
import Icon from '../Icon.astro';
import { getTerms } from '../../lib/terms';
import type { IconName } from '../../icons/lucide';

const terms = await getTerms();
const icons: Record<string, IconName> = {
  'fit-call': 'video', blueprint: 'map', 'launch-services': 'kanban', 'launch-products': 'package',
  'launch-make': 'factory', custom: 'puzzle', keep: 'life-buoy',
};
const card = (id: string) => {
  const p = terms.pkg(id);
  return { name: p.name, audience: p.for, includes: p.includes.map(terms.fmt), price: terms.price(p), from: p.price !== null, icon: icons[id] };
};
---

<Section id="pricing" title="Clear prices, before you commit." class="pricing ledger">
  <div class="pricing__grid" data-animate>
    <div class="pricing__row pricing__row--2" data-reveal-children>
      <PackageCard {...card('fit-call')} wide />
      <PackageCard {...card('blueprint')} wide />
    </div>
    <div class="pricing__row pricing__row--3" data-reveal-children>
      <PackageCard {...card('launch-services')} featured />
      <PackageCard {...card('launch-products')} featured />
      <PackageCard {...card('launch-make')} featured />
    </div>
    <div class="pricing__row pricing__row--2" data-reveal-children>
      <PackageCard {...card('custom')} wide />
      <PackageCard {...card('keep')} wide />
    </div>
  </div>
  <div class="promises" data-reveal>
    <h3 class="promises__title">
      <Icon name="stamp" size={22} />Our promises, in writing.
    </h3>
    <ul class="checks promises__list" role="list">
      {
        terms.guarantees.map((text) => (
          <li>
            <Icon name="check" size={20} />
            <span>{terms.fmt(text)}</span>
          </li>
        ))
      }
    </ul>
  </div>
  <div class="pricing__foot">
    <p class="pricing__note">{terms.licensesNote}</p>
    <Button href="/book" arrow>Book a fit call</Button>
  </div>
</Section>

<style is:global>
  /* #4 ledger grid fades in (0 → 7%) once the packages are in view */
  @media (prefers-reduced-motion: no-preference) {
    .js .pricing.ledger::before {
      transition: opacity var(--dur-4) var(--ease-out);
    }
    .js .pricing.ledger:has(.pricing__grid:not(.is-in))::before {
      opacity: 0;
    }
  }
  .pricing__grid {
    display: grid;
    gap: var(--space-4);
  }
  .pricing__row {
    display: grid;
    gap: var(--space-4);
  }
  @media (min-width: 768px) {
    .pricing__grid,
    .pricing__row {
      gap: var(--space-5);
    }
    .pricing__row--2 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .pricing__row--3 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .promises {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-6);
    padding: var(--space-5);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    background-color: var(--surface);
  }
  .promises__title {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .promises__title .icon {
    flex: none;
    color: var(--link);
  }
  .promises__list li {
    max-width: none;
    font-weight: 600;
    line-height: 1.45;
  }
  @media (min-width: 768px) {
    .promises {
      padding: var(--space-6);
    }
    .promises__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-3) var(--space-6);
    }
  }
  @media (min-width: 1024px) {
    .promises__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .pricing__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }
  .pricing__note {
    font-weight: 700;
  }
</style>
